# WildWise Environment Configuration
# Copy this file to backend/.env and fill in your values
# KABHI BHI REAL API KEYS GIT MEIN COMMIT MAT KARO

# --- Online AI Generation Flag ---
# Disabled by default (offline-first). Set to true only if online model generation is desired.
ENABLE_ONLINE_GENERATION=false

# --- OpenRouter API Configuration ---
# Read only by the backend. Never exposed to frontend, client storage, or API responses.
# Get free API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL_ID=nvidia/nemotron-3.5-lightning:free
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# --- Security & Rate Limiting ---
# Request timeout in seconds
LLM_TIMEOUT_SECONDS=15
# Sliding window in-memory rate limit (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=10

# --- Backend Server ---
# CORS allowed frontend origin
FRONTEND_URL=http://localhost:5173

# --- Frontend (Vite) ---
# Backend base URL for the web app
VITE_API_URL=http://localhost:8000
